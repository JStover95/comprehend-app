{
  "name": "cdk",
  "version": "0.1.0",
  "bin": {
    "cdk": "bin/cdk.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --collectCoverageFrom='lib/**/*.ts'",
    "cdk": "cdk",
    "lint": "eslint lib test --ext .ts",
    "format": "prettier --write 'lib/**/*.ts' 'test/**/*.ts'"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/aws-lambda": "^8.10.159",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.16.0",
    "aws-cdk": "2.1100.1",
    "eslint": "^9.39.2",
    "jest": "^30.2.0",
    "prettier": "3.7.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.1"
  },
  "dependencies": {
    "@aws-sdk/client-rds": "^3.958.0",
    "@aws-sdk/client-secrets-manager": "^3.958.0",
    "@aws-sdk/rds-signer": "^3.958.0",
    "aws-cdk-lib": "2.232.1",
    "aws-lambda": "^1.0.7",
    "constructs": "^10.0.0",
    "pg": "^8.16.3"
  }
}
